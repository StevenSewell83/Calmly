{
  "$schema": "./allow-list.schema.json",
  "_doc": "Documented schema-parity divergences. Add an entry here only when the divergence is legitimate (e.g. server-only auth state, local-only working state, sync metadata that doesn't belong on the public DTO). The `reason` field is required so future readers know why. See README.md for the workflow.",
  "tables": [
    {
      "table": "focus_sessions",
      "presentIn": ["shared", "desktop"],
      "absentIn": ["server"],
      "reason": "CL-09 focus mode is per-device working state and intentionally does not sync (see shared/src/model/focus.ts header)."
    },
    {
      "table": "secrets",
      "presentIn": ["desktop"],
      "absentIn": ["shared", "server"],
      "reason": "F-12 desktop-only encrypted-at-rest secret store; ciphertext never leaves the main process. No DTO needed."
    },
    {
      "table": "op_queue",
      "presentIn": ["desktop"],
      "absentIn": ["shared", "server"],
      "reason": "F-11b client-side outbox for queued sync ops. Local-only; the server only sees the dequeued payloads."
    },
    {
      "table": "sync_state",
      "presentIn": ["desktop"],
      "absentIn": ["shared", "server"],
      "reason": "F-11b client-side cursor for the most recent pulled version. Local-only."
    },
    {
      "table": "magic_link_tokens",
      "presentIn": ["server"],
      "absentIn": ["shared", "desktop"],
      "reason": "F-08 server-only magic-link auth state. Token hashes never replicate; raw tokens never persist anywhere."
    },
    {
      "table": "sessions",
      "presentIn": ["server"],
      "absentIn": ["shared", "desktop"],
      "reason": "F-08 server-only session table. id_hash is private to the server; the cookie value is what the client knows."
    }
  ],
  "divergences": [
    {
      "table": "inbox_items",
      "column": "version",
      "presentIn": ["desktop", "server"],
      "absentIn": ["shared"],
      "reason": "F-11 sync metadata; server SEQUENCE-driven, desktop tracks for reconciliation. Not part of the public DTO."
    },
    {
      "table": "inbox_items",
      "column": "deleted_at",
      "presentIn": ["desktop", "server"],
      "absentIn": ["shared"],
      "reason": "F-11 tombstone timestamp; sync-internal."
    },
    {
      "table": "inbox_items",
      "column": "updated_at",
      "presentIn": ["server"],
      "absentIn": ["shared", "desktop"],
      "reason": "F-11 server-side sync mtime. Desktop derives mtime from local writes via sync_state; the DTO has no analogue."
    },
    {
      "table": "tasks",
