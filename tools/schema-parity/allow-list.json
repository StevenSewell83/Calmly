{
  "$schema": "./allow-list.schema.json",
  "_doc": "Documented schema-parity divergences. Add an entry here only when the divergence is legitimate (e.g. server-only auth state, local-only working state, sync metadata that doesn't belong on the public DTO). The `reason` field is required so future readers know why. See README.md for the workflow.",
  "tables": [
    {
      "table": "focus_sessions",
      "presentIn": ["shared", "desktop"],
      "absentIn": ["server"],
      "reason": "CL-09 focus mode is per-device working state and intentionally does not sync (see shared/src/model/focus.ts header)."
    },
    {
      "table": "secrets",
      "presentIn": ["desktop"],
      "absentIn": ["shared", "server"],
      "reason": "F-12 desktop-only encrypted-at-rest secret store; ciphertext never leaves the main process. No DTO needed."
    },
    {
      "table": "op_queue",
      "presentIn": ["desktop"],
      "absentIn": ["shared", "server"],
      "reason": "F-11b client-side outbox for queued sync ops. Local-only; the server only sees the dequeued payloads."
    },
    {
      "table": "sync_state",
      "presentIn": ["desktop"],
      "absentIn": ["shared", "server"],
      "reason": "F-11b client-side cursor for the most recent pulled version. Local-only."
    },
    {
      "table": "magic_link_tokens",
      "presentIn": ["server"],
      "absentIn": ["shared", "desktop"],
      "reason": "F-08 server-only magic-link auth state. Token hashes never replicate; raw tokens never persist anywhere."
    },
    {
      "table": "sessions",
      "presentIn": ["server"],
      "absentIn": ["shared", "desktop"],
      "reason": "F-08 server-only session table. id_hash is private to the server; the cookie value is what the client knows."
    },
    {
      "table": "calendar_accounts",
      "presentIn": ["desktop", "server"],
      "absentIn": ["shared"],
      "reason": "CAL-01 connection metadata; not sync-replicated. The shared `CalendarAccount` type in shared/src/types/calendar.ts is a public wire shape (id, provider, email, status); it intentionally omits user_id / created_at / updated_at which are private to each side."
    },
    {
      "table": "oauth_states",
      "presentIn": ["server"],
      "absentIn": ["shared", "desktop"],
      "reason": "CAL-01 server-only short-lived state + PKCE verifier rows for the OAuth handshake. Never replicates; never crosses the wire."
    },
    {
      "table": "oauth_tickets",
      "presentIn": ["server"],
      "absentIn": ["shared", "desktop"],
      "reason": "CAL-01 server-only one-shot pickup table for OAuth completion (refresh + access tokens, deleted on redeem). Never replicates."
    },
    {
      "table": "_search_meta",
      "presentIn": ["desktop"],
      "absentIn": ["shared", "server"],
      "reason": "SRCH-02 FTS backfill bookkeeping (status, timings, row count). Local search infrastructure; never syncs."
    },
    {
      "table": "ai_usage",
      "presentIn": ["desktop"],
      "absentIn": ["shared", "server"],
      "reason": "Local AI usage metering backing Settings > AI usage panel. Per-device counters; never syncs."
    },
    {
      "table": "daily_reflections",
      "presentIn": ["desktop"],
      "absentIn": ["shared", "server"],
      "reason": "CL-13 daily shutdown reflections. Carries the sync trio in anticipation of review sync, but is not in the sync registry, has no DTO, and does not replicate yet (see calmly-aa3 audit)."
    },
    {
      "table": "replan_events",
      "presentIn": ["desktop"],
      "absentIn": ["shared", "server"],
      "reason": "CL-12 replan telemetry events. Local-only per the migration header."
    },
    {
      "table": "stuck_sessions",
      "presentIn": ["desktop"],
      "absentIn": ["shared", "server"],
      "reason": "CL-10 stuck rescue sessions. Local-only per-device focus working state (no sync columns)."
    },
    {
      "table": "telemetry_outbox",
      "presentIn": ["desktop"],
      "absentIn": ["shared", "server"],
      "reason": "POL-01 client-side outbox buffering allow-listed telemetry events for batch flush to /telemetry/ingest. Local-only (op_queue pattern)."
    },
    {
      "table": "telegram_linking_codes",
      "presentIn": ["server"],
      "absentIn": ["shared", "desktop"],
      "reason": "TG-02a server-only one-time linking codes; short-lived auth state that never replicates."
    },
    {
      "table": "telemetry_events",
      "presentIn": ["server"],
      "absentIn": ["shared", "desktop"],
      "reason": "POL-01 server-side telemetry ingest store; append-only analytics with no client DTO."
    }
  ],
  "divergences": [
    {
      "table": "inbox_items",
      "column": "version",
      "presentIn": ["desktop", "server"],
      "absentIn": ["shared"],
      "reason": "F-11 sync metadata; server SEQUENCE-driven, desktop tracks for reconciliation. Not part of the public DTO."
    },
    {
      "table": "inbox_items",
      "column": "deleted_at",
      "presentIn": ["desktop", "server"],
      "absentIn": ["shared"],
      "reason": "F-11 tombstone timestamp; sync-internal."
    },
    {
      "table": "inbox_items",
      "column": "updated_at",
      "presentIn": ["server"],
      "absentIn": ["shared", "desktop"],
      "reason": "F-11 server-side sync mtime. Desktop derives mtime from local writes via sync_state; the DTO has no analogue."
    },
    {
      "table": "tasks",
