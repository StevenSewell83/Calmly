{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "lib": ["ES2022"],
    "types": ["node", "vite/client", "electron-vite/node"],
    "module": "ESNext",
    "moduleResolution": "Bundler"
  },
  "include": [
    "src/main/**/*",
    "src/preload/**/*",
    "electron.vite.config.ts",
    "playwright.config.ts",
    "e2e/**/*"
  ]
}
