{
  "name": "@calmly/desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "rebuild-native": "electron-rebuild -f -w better-sqlite3",
    "postinstall": "electron-rebuild -f -w better-sqlite3 || echo \"electron-rebuild skipped (run pnpm --filter @calmly/desktop rebuild-native after deps install)\"",
    "test": "vitest run",
    "test:perf": "PERF_TEST=1 vitest run --config vitest.perf.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:build": "electron-vite build && playwright test",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.92.0",
    "@calmly/shared": "workspace:*",
    "@dnd-kit/core": "6.1.0",
    "@dnd-kit/modifiers": "7.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "better-sqlite3": "11.5.0",
    "electron-log": "5.2.0",
    "electron-window-state": "5.0.3",
    "lucide-react": "0.460.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.27.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@electron/rebuild": "3.7.1",
    "@playwright/test": "1.48.2",
    "@testcontainers/postgresql": "10.13.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "7.6.11",
    "@types/node": "20.16.10",
    "@types/pg": "8.11.10",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.3",
    "autoprefixer": "10.4.20",
    "electron": "32.2.5",
    "electron-vite": "2.3.0",
    "jsdom": "^29.1.1",
    "pg": "8.13.1",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.14",
    "typescript": "5.6.3",
    "vite": "5.4.10",
    "vitest": "2.1.4"
  }
}
