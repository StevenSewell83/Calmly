{
  "name": "@calmly/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node --import=tsx/esm src/index.ts",
    "migrate": "node-pg-migrate -m migrations -j cjs",
    "migrate:create": "node-pg-migrate create -m migrations -j cjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@calmly/shared": "workspace:*",
    "dotenv": "16.4.5",
    "fastify": "5.1.0",
    "pg": "8.13.1",
    "pino-pretty": "11.3.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/node": "20.16.10",
    "@types/pg": "8.11.10",
    "node-pg-migrate": "7.7.1",
    "tsx": "4.19.2",
    "typescript": "5.6.3"
  }
}
