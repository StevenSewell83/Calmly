NODE_ENV=development
PORT=3001
HOST=127.0.0.1
DATABASE_URL=postgres://calmly:calmly@localhost:5432/calmly
LOG_LEVEL=info

# F-08 magic-link auth
APP_URL=http://localhost:3001
COOKIE_NAME=calmly_session
# Must be at least 32 chars in any environment. Replace in prod.
COOKIE_SECRET=dev-cookie-secret-change-in-prod-32+
MAGIC_LINK_TTL_MIN=15
SESSION_TTL_DAYS=30

# F-09 email send adapter
# 'console' (dev: write .html to DEV_MAIL_DIR + log link) | 'resend' (prod)
EMAIL_SENDER=console
DEV_MAIL_DIR=./.dev-mail
# Required when EMAIL_SENDER=resend:
# EMAIL_FROM="Calmly <hello@yourdomain.com>"
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
