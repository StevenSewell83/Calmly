# Required
DATABASE_URL=postgresql://calmly:calmly@localhost:5432/calmly

# Optional — override defaults
PORT=3001
HOST=127.0.0.1
NODE_ENV=development
LOG_LEVEL=info
APP_URL=http://localhost:3001

# Auth secrets (use `openssl rand -base64 32` to generate)
COOKIE_SECRET=dev-cookie-secret-change-in-prod-32+

# Email
EMAIL_SENDER=console
DEV_MAIL_DIR=./.dev-mail
# EMAIL_SENDER=resend
# RESEND_API_KEY=re_...
# EMAIL_FROM=noreply@example.com

# Telegram (optional — omit to disable bot integration)
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# TELEGRAM_WEBHOOK_SECRET=<openssl rand -hex 32>
# TELEGRAM_WEBHOOK_URL=https://sync.example.com

# Transcription (cloud, used by the Telegram voice handler — TG-04)
# TRANSCRIPTION_PROVIDER=openai            # 'openai' (default) or 'mock' (tests/dev)
# OPENAI_TRANSCRIPTION_KEY=sk-...
# Optional overrides:
# OPENAI_TRANSCRIPTION_MODEL=whisper-1
# OPENAI_TRANSCRIPTION_BASE_URL=https://api.openai.com

# Calendar OAuth (optional — omit a provider's pair to disable that provider)
# Google Cloud project: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must be: <APP_URL>/oauth/google/callback
# GOOGLE_CLIENT_ID=...
# GOOGLE_CLIENT_SECRET=...
# Microsoft App Registration: https://entra.microsoft.com (App registrations)
# Multi-tenant; redirect URI must be: <APP_URL>/oauth/microsoft/callback
# MICROSOFT_CLIENT_ID=...
# MICROSOFT_CLIENT_SECRET=...
# Optional: override the redirect base if behind a proxy on a different host
# OAUTH_REDIRECT_BASE_URL=https://sync.example.com
# Optional: dedicated HMAC secret for one-shot pickup tickets (defaults to COOKIE_SECRET)
# OAUTH_TICKET_SECRET=<openssl rand -base64 48>
# Optional: TTL overrides (seconds)
# OAUTH_STATE_TTL_SEC=600
# OAUTH_TICKET_TTL_SEC=300
